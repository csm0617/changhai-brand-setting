{
  "name": "changhai-brand-setting",
  "version": "0.1.0",
  "description": "White-label the DeepSeek Harness Web GUI from a Settings page: the sidebar mark and wordmark, the blank-session headline, tagline and badge, the tab title and favicon — shipping the Changhai mark and tagline as defaults. 长海品牌设置：侧栏标志与名称、空会话首页标题、小标语与徽标、标签页标题与图标，均可在设置页中配置，并内置长海标志与标语。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "test": "node --test tests/client-smoke.test.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js",
    "pack": "pnpm pack"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "changhai",
    "brand",
    "logo",
    "wordmark",
    "sidebar",
    "white-label"
  ]
}
